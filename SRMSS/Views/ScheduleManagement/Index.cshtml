                            Dashboard


                        </span>



                    </a>









                    <!-- Route Management -->


                    <a href="/RouteManagement"
                       class="menu-item">



                        <img src="~/Images/location-icon.png"
                             alt="Route Management" />



                        <span>


                            Route Management


                        </span>



                    </a>









                    <!-- Route List -->


                    <a href="/RouteList"
                       class="menu-item">



                        <img src="~/Images/route-list-icon.png"
                             alt="Route List" />



                        <span>


                            Route List


                        </span>



                    </a>









                    <!-- Schedule Management ACTIVE -->


