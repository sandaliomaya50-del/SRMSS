                 ===================================================== -->
            <script>

                            document.addEventListener("DOMContentLoaded", function () {

                                const reportType = document.getElementById("reportType");
                                const dateRange = document.getElementById("dateRange");
                                const routeFilter = document.getElementById("routeFilter");

                                const applyFiltersButton =
                                    document.getElementById("applyFiltersButton");

                                const resetFiltersButton =
                                    document.getElementById("resetFiltersButton");

                                const exportPdfButton =
                                    document.getElementById("exportPdfButton");


                                // =================================================
                                // APPLY FILTERS
                                // =================================================
                                if (applyFiltersButton) {

                                    applyFiltersButton.addEventListener("click", function () {

                                        const selectedReportType =
                                            reportType ? reportType.value : "all";

                                        const selectedDateRange =
                                            dateRange ? dateRange.value : "";

                                        const selectedRoute =
                                            routeFilter ? routeFilter.value : "all";

                                        console.log("Report Type:", selectedReportType);
                                        console.log("Date Range:", selectedDateRange);
                                        console.log("Route:", selectedRoute);

                                    });

                                }


                                // =================================================
                                // RESET FILTERS
                                // =================================================
                                if (resetFiltersButton) {

                                    resetFiltersButton.addEventListener("click", function () {

                                        if (reportType) {
                                            reportType.value = "all";
                                        }

                                        if (dateRange) {
                                            dateRange.value = "apr-2025";
                                        }

                                        if (routeFilter) {
                                            routeFilter.value = "all";
                                        }

                                    });

                                }


                                // =================================================
                                // EXPORT PDF / PRINT
                                // =================================================
                                if (exportPdfButton) {

                                    exportPdfButton.addEventListener("click", function () {

                                        window.print();

                                    });

                                }


                                // =================================================
                                // RECENT REPORT ACTION BUTTONS
                                // =================================================
                                const reportActionButtons =
                                    document.querySelectorAll(
                                        ".recent-report-action-button"
                                    );

                                reportActionButtons.forEach(function (button) {

                                    button.addEventListener("click", function () {

                                        const reportName =
                                            this.getAttribute("data-report");

                                        alert(
                                            reportName +
                                            " selected."
                                        );

                                    });

                                });


                                // =================================================
                                // KEEP ACTIVE REPORT MENU ITEM VISIBLE
                                // =================================================
                                const activeMenuItem =
                                    document.querySelector(
                                        ".sidebar-menu .menu-item.active"
                                    );

                                if (activeMenuItem) {

                                    activeMenuItem.scrollIntoView({
                                        block: "nearest"
                                    });

                                }

                            });

            </script>
