                        </span>





                    </button>









                    <div class="admin-profile">





                        <div class="admin-avatar">



                            <img src="~/Images/user-icon.png"
                                 alt="Admin" />



                        </div>









                        <div class="admin-information">





                            <strong>


                                Admin


                            </strong>







                            <span>


                                System Administrator


                            </span>





                        </div>









                        <span class="admin-arrow">


                            ⌄


                        </span>





                    </div>







                </div>







            </header>









            <!-- =====================================================
             CONTENT AREA
        ====================================================== -->


            <section class="content-area">
                
            <!-- =====================================================
                 PAGE HEADING
            ====================================================== -->


            <div class="page-heading">





                <div class="heading-left">





                    <a href="/Dashboard"
                       class="back-button">


                        ←


                    </a>








                    <div>


                        <h1>


                            Schedule Management


                        </h1>







                        <p>


                            Add New Schedule


                        </p>



                    </div>





                </div>









                <!-- =====================================================
                     BREADCRUMB
                ====================================================== -->


                <div class="breadcrumb">





                    <img src="~/Images/schedule-management-icon.png"
                         alt="Schedule" />







                    <span>


                        Schedules


                    </span>







                    <span class="breadcrumb-slash">


                        /


                    </span>







                    <span>


                        Add Schedule


                    </span>







                </div>






            </div>









            <!-- =====================================================
                 ADD NEW SCHEDULE CARD
            ====================================================== -->


            <div class="schedule-card">





                <div class="card-heading">





                    <div class="card-heading-icon">



                        <img src="~/Images/schedule-management-icon.png"
                             alt="Add Schedule" />



                    </div>









                    <div>



                        <h2>


                            Add New Schedule


                        </h2>







                        <p>


                            Enter the schedule details below to create a new schedule.


                        </p>



                    </div>







                </div>









                <!-- =====================================================
                     FORM START
                ====================================================== -->


                <form asp-controller="ScheduleManagement"
                      asp-action="SaveSchedule"
                      method="post">





                    @Html.AntiForgeryToken()

                        <!-- =====================================================
                         ROUTE / BUS
                    ====================================================== -->


                        <div class="form-row">





                            <!-- ROUTE -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/location-icon.png"
                                         alt="Route" />



                                    <span>


                                        Route


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <select name="route"
                                        required>



                                    <option value="">


                                        Select route


                                    </option>







                                    @foreach (var route in Model.Routes)
                                    {


                                        <option value="@route.Value">


                                            @route.Text


                                        </option>


                                    }





                                </select>





                            </div>









                            <!-- BUS -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/bus-icon.png"
                                         alt="Bus" />



                                    <span>


                                        Bus


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <select name="bus"
                                        required>



                                    <option value="">


                                        Select bus


                                    </option>







                                    @foreach (var bus in Model.Buses)
                                    {


                                        <option value="@bus.Value">


                                            @bus.Text


                                        </option>


                                    }





                                </select>





                            </div>







                        </div>









                        <!-- =====================================================
                         DRIVER / DATE
                    ====================================================== -->


                        <div class="form-row">





                            <!-- DRIVER -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/driver-management-icon.png"
                                         alt="Driver" />



                                    <span>


                                        Driver


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <select name="driver"
                                        required>



                                    <option value="">


                                        Select driver


                                    </option>







                                    @foreach (var driver in Model.Drivers)
                                    {


                                        <option value="@driver.Value">


                                            @driver.Text


                                        </option>


                                    }





                                </select>





                            </div>









                            <!-- DATE -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/calender-icon.png"
                                         alt="Date" />



                                    <span>


                                        Date


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <input type="date"
                                       name="date"
                                       required />





                            </div>







                        </div>









                        <!-- =====================================================
                         DEPARTURE / ARRIVAL TIME
                    ====================================================== -->


                        <div class="form-row">





                            <!-- DEPARTURE TIME -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/departure-time-icon.png"
                                         alt="Departure Time" />



                                    <span>


                                        Departure Time


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <input type="time"
                                       name="departureTime"
                                       required />





                            </div>









                            <!-- ARRIVAL TIME -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/departure-time-icon.png"
                                         alt="Arrival Time" />



                                    <span>


                                        Arrival Time


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <input type="time"
                                       name="arrivalTime"
                                       required />





                            </div>







                        </div>

                        <!-- =====================================================
                         STATUS / NOTES
                    ====================================================== -->


                        <div class="form-row">





                            <!-- SCHEDULE STATUS -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/schedule-management-icon.png"
                                         alt="Schedule Status" />



                                    <span>


                                        Schedule Status


                                    </span>







                                    <span class="required">


                                        *


                                    </span>



                                </label>









                                <select name="scheduleStatus"
                                        required>



                                    <option value="">


                                        Select status


                                    </option>







                                    <option value="On Time">


                                        On Time


                                    </option>







                                    <option value="Delayed">


                                        Delayed


                                    </option>







                                    <option value="Completed">


                                        Completed


                                    </option>





                                </select>





                            </div>









                            <!-- NOTES -->


                            <div class="form-group">



                                <label>


                                    <img src="~/Images/route-list-icon.png"
                                         alt="Notes" />



                                    <span>


                                        Notes


                                    </span>



                                </label>









                                <textarea name="notes"
                                          placeholder="Enter additional notes"></textarea>





                            </div>







                        </div>









                        <!-- =====================================================
                         FORM BUTTONS
                    ====================================================== -->


                        <div class="form-buttons">





                            <button type="reset"
                                    class="reset-button">





                                <span class="reset-icon">


                                    ↻


                                </span>







                                <span>


                                    Reset


                                </span>






                            </button>









                            <button type="submit"
                                    class="save-schedule-button">





                                <span class="save-icon">


                                    ▣


                                </span>







                                <span>


                                    Save Schedule


                                </span>






                            </button>







                        </div>








                    </form>








                </div>
                <!-- schedule-card END -->
                <!-- =====================================================
                 SCHEDULE OVERVIEW
            ====================================================== -->


                <section class="schedule-overview-card">





                    <div class="card-heading">





                        <div class="card-heading-icon">



                            <img src="~/Images/calender-icon.png"
                                 alt="Schedule Overview" />



                        </div>









                        <div>



                            <h2>


                                Schedule Overview


                            </h2>







                            <p>


                                View scheduled trips and daily schedule summary.


                            </p>



                        </div>







                    </div>









                    <!-- =====================================================
                     CALENDAR
                ====================================================== -->


                    <div class="schedule-calendar">





                        <div class="calendar-header">





                            <button type="button">


                                ‹


                            </button>







                            <h3>


                                September 2026


                            </h3>







                            <button type="button">


                                ›


                            </button>







                        </div>









                        <div class="calendar-days">





                            <span>Sun</span>


                            <span>Mon</span>


                            <span>Tue</span>


                            <span>Wed</span>


                            <span>Thu</span>


                            <span>Fri</span>


                            <span>Sat</span>





                        </div>









                        <div class="calendar-date-grid">





                            <span></span>


                            <span>1</span>


                            <span>2</span>


                            <span>3</span>


                            <span>4</span>


                            <span>5</span>


                            <span>6</span>


                            <span>7</span>


                            <span class="selected-date">8</span>


                            <span>9</span>


                            <span>10</span>


                            <span>11</span>


                            <span>12</span>


                            <span>13</span>


                            <span>14</span>


                            <span>15</span>


                            <span>16</span>


                            <span>17</span>


                            <span>18</span>


                            <span>19</span>


                            <span>20</span>


                            <span>21</span>


                            <span>22</span>


                            <span>23</span>


                            <span>24</span>


                            <span>25</span>


                            <span>26</span>


                            <span>27</span>


                            <span>28</span>


                            <span>29</span>


                            <span>30</span>





                        </div>









                    </div>
                    <!-- schedule-calendar END -->
                    <!-- =====================================================
                     TODAY'S SCHEDULE SUMMARY
                ====================================================== -->


                    <div class="schedule-summary-card">

                        <div class="summary-heading">





                            <h2>


                                Today's Schedule Summary


                            </h2>







                        </div>









                        <div class="summary-grid">









                            <!-- TOTAL TRIPS -->


                            <div class="summary-box">





                                <img src="~/Images/bus-icon.png"
                                     alt="Total Trips" />







                                <h3>


                                    @Model.TotalTrips


                                </h3>







                                <p>


                                    TOTAL TRIPS


                                </p>






                            </div>









                            <!-- ON TIME -->


                            <div class="summary-box">





                                <img src="~/Images/green-tick-icon.png"
                                     alt="On Time" />







                                <h3>


                                    @Model.OnTimeTrips


                                </h3>







                                <p>


                                    ON TIME


                                </p>






                            </div>









                            <!-- DELAYED -->


                            <div class="summary-box">





                                <img src="~/Images/yellow-tick-icon.png"
                                     alt="Delayed" />







                                <h3>


                                    @Model.DelayedTrips


                                </h3>







                                <p>


                                    DELAYED


                                </p>






                            </div>









                            <!-- COMPLETED -->


                            <div class="summary-box">





                                <img src="~/Images/grey-tick-icon.png"
                                     alt="Completed" />







                                <h3>


                                    @Model.CompletedTrips


                                </h3>







                                <p>


                                    COMPLETED


                                </p>






                            </div>









                        </div>
                        <!-- summary-grid END -->









                    </div>
                    <!-- schedule-summary-card END -->









                </section>
                <!-- schedule-overview-card END -->









            </section>
            <!-- content-area END -->

            







        </main>
        <!-- main-content END -->









    </div>
    <!-- schedule-management-page END -->









    <script>


            // =====================================================
            // CLOSE NOTIFICATION
            // =====================================================


            function closeScheduleNotification()
            {


                const notification =
                    document.getElementById(
                        "scheduleNotification"
                    );



                if (notification)
                {


                    notification.classList.add(
                        "notification-hide"
                    );



                    setTimeout(function ()
                    {


                        notification.style.display = "none";


                    }, 400);


                }


            }









            // =====================================================
            // AUTO HIDE NOTIFICATION
            // =====================================================


            window.addEventListener(
                "load",
                function ()
                {


                    const notification =
                        document.getElementById(
                            "scheduleNotification"
                        );



                    if (notification)
                    {


                        setTimeout(function ()
                        {


                            closeScheduleNotification();


                        }, 4000);


                    }


                }
            );


    </script>









</body>


</html>

