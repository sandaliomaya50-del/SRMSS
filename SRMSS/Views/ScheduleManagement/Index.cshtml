                        </span>





                    </div>






                </div>









                <nav class="sidebar-menu">

                    <!-- Dashboard -->


                    <a href="/Dashboard"
                       class="menu-item">



                        <img src="~/Images/home-icon.png"
                             alt="Dashboard" />



