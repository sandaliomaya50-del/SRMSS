                        <span>


                            Depot Dashboard


                        </span>



                    </a>









                    <!-- Reports & Analytics -->


                    <a href="/Reports"
                       class="menu-item">



                        <img src="~/Images/reports-analytics-icon.png"
                             alt="Reports Analytics" />



                        <span>


                            Reports &amp; Analytics


                        </span>



                    </a>









                    <!-- User Management -->


                    <a href="/UserManagement"
                       class="menu-item">



                        <img src="~/Images/user-icon.png"
                             alt="User Management" />



                        <span>


                            User Management


                        </span>



                    </a>









                    <!-- Profile / Settings -->


                    <a href="/Profile"
                       class="menu-item">



                        <img src="~/Images/profile-settings-icon.png"
                             alt="Profile Settings" />



                        <span>


                            Profile / Settings


                        </span>



                    </a>









                </nav>









                <div class="sidebar-bottom">





                    <div class="sidebar-slogan">





                        <strong>


                            Smart Transport.


                        </strong>







                        <span>


                            Better Routes.


                        </span>







                        <span>


                            Efficient Operations.


                        </span>






                    </div>







                </div>







            </div>







        </aside>









        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->


        <main class="main-content">
            







            <!-- =====================================================
             TOP HEADER
        ====================================================== -->


            <header class="top-header">





                <div class="search-box">





                    <span class="search-symbol">


                        ⌕


                    </span>







                    <input type="text"
