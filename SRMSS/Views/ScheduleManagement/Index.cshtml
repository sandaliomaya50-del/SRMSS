@model SRMSS.ViewModels.ScheduleManagementViewModel


@{
    Layout = null;

    ViewData["Title"] = "Schedule Management";


    // =====================================================
    // NOTIFICATION DATA
    // =====================================================


    var notificationType = "";

    var notificationTitle = "";

    var notificationMessage = "";

    var notificationIcon = "";


    if (TempData["SuccessMessage"] != null)
    {

        notificationType = "success";

        notificationTitle = "Success";

        notificationMessage =
            TempData["SuccessMessage"]?.ToString() ?? "";

        notificationIcon = "✓";

    }
    else if (TempData["ErrorMessage"] != null)
    {

        notificationType = "error";

        notificationTitle = "Error";

        notificationMessage =
            TempData["ErrorMessage"]?.ToString() ?? "";

        notificationIcon = "!";

    }
    else if (TempData["WarningMessage"] != null)
    {

        notificationType = "warning";

        notificationTitle = "Warning";

        notificationMessage =
            TempData["WarningMessage"]?.ToString() ?? "";

        notificationIcon = "⚠";

    }
    else if (TempData["InfoMessage"] != null)
    {

        notificationType = "information";

        notificationTitle = "Information";

        notificationMessage =
            TempData["InfoMessage"]?.ToString() ?? "";

        notificationIcon = "i";

    }

}



<!DOCTYPE html>

<html lang="en">


<head>


    <meta charset="utf-8" />


    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        Schedule Management - SRMSS
    </title>


    <link rel="stylesheet"
          href="~/css/schedule-management.css" />
          
    <style>


        /* =====================================================
           NOTIFICATION CARD
        ====================================================== */


        .schedule-notification {

            position: fixed;

            top: 25px;

            right: 25px;

            width: 340px;

            background: #ffffff;

            border-radius: 14px;

            box-shadow: 0 8px 25px rgba(0,0,0,0.15);

            display: flex;

            align-items: center;

            gap: 12px;

            padding: 15px;

            z-index: 9999;

            border-left: 5px solid #2196f3;

        }


        .schedule-notification.success {

            border-left-color: #28a745;

        }


        .schedule-notification.error {

            border-left-color: #dc3545;

        }


        .schedule-notification.warning {

            border-left-color: #ff9800;

        }


        .schedule-notification.information {

            border-left-color: #2196f3;

        }


        .notification-icon-circle {

            width: 38px;

            height: 38px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 20px;

            font-weight: bold;

            background: #f2f2f2;

        }


        .notification-content {

            flex: 1;

        }


        .notification-content h4 {

            margin: 0;

            font-size: 15px;

            font-weight: 700;

        }


        .notification-content p {

            margin: 5px 0 0;

            font-size: 13px;

            color: #555;

        }


        .notification-close {

            border: none;

            background: transparent;

            font-size: 22px;

            cursor: pointer;

            color: #777;

        }


        .notification-close:hover {

            color: #000;

        }


        .notification-hide {

            display: none;

        }


        @@media(max-width:600px)
        {


            .schedule-notification
            {

                width: calc(100% - 40px);

                right: 20px;

                top: 20px;

            }


        }


    </style>


</head>


<body>

    @if (!string.IsNullOrEmpty(notificationMessage))
    {


        <div class="schedule-notification @notificationType"
             id="scheduleNotification">





            <div class="notification-icon-circle">


                @notificationIcon


            </div>







            <div class="notification-content">





                <h4>


                    @notificationTitle


                </h4>







                <p>


                    @notificationMessage


                </p>






            </div>








            <button type="button"
                    class="notification-close"
                    onclick="closeScheduleNotification()">





                ×





            </button>







        </div>


    }









    <div class="schedule-management-page">







        <!-- =====================================================
